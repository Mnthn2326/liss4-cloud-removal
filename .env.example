# ==============================================================================
# Environment Configuration Template for Remote-Sensing Cloud Reconstruction
# Copy this file to .env and configure your environment: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MLflow Experiment Tracking
# ------------------------------------------------------------------------------
# Local file-backed tracking (default):
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=rice2-compact-unet

# Remote DagsHub / Hosted tracking (optional):
# MLFLOW_TRACKING_URI=https://dagshub.com/<username>/liss4-cloud-removal.mlflow
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=

# ------------------------------------------------------------------------------
# 2. Model Serving & API Service
# ------------------------------------------------------------------------------
MODEL_CHECKPOINT=checkpoints/rice2/best_rice2_compact_unet.pt
API_HOST=127.0.0.1
API_PORT=8000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# ------------------------------------------------------------------------------
# 3. Optional Benchmark Data Acquisition Credentials
# ------------------------------------------------------------------------------
# Credentials for streaming raw SEN12MS-CR archives from MediaTUM:
SEN12MSCR_FTP_HOST=dataserv.ub.tum.de
SEN12MSCR_FTP_USER=
SEN12MSCR_FTP_PASS=
