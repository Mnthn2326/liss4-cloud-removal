# Virtual Environment
.venv/
venv/
ENV/
env/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
*.xml
htmlcov/
.tox/
.nox/

# Jupyter Notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/

# Data & Satellite Imagery
# Ignore large binary payloads but preserve DVC pointer files, gitkeeps, and manifests
/data/raw/*
!/data/raw/.gitkeep
!/data/raw/*.dvc
!/data/raw/.gitignore
!/data/raw/manifest.*
!/data/raw/quarantine/
!/data/raw/quarantine/.gitkeep

/data/interim/*
!/data/interim/.gitkeep
!/data/interim/*.dvc
!/data/interim/.gitignore

/data/processed/*
!/data/processed/.gitkeep
!/data/processed/*.dvc
!/data/processed/.gitignore

# Satellite Imagery and Binary Archives
*.tif
*.tiff
*.hdf
*.nc
*.zip
*.tar.gz
*.tar
*.gz

# Models & Artifacts (Ignore binary weights, allow DVC pointers and configs)
/models/*
!/models/.gitkeep
!/models/*.dvc
!/models/.gitignore
/checkpoints/*
!/checkpoints/.gitkeep
!/checkpoints/*.dvc
!/checkpoints/.gitignore
*.pt
*.pth
*.onnx
*.pkl
*.h5

# Experiment Tracking (MLflow)
mlruns/
mlartifacts/

# DVC internals (Ignore local cache and local overrides, allow pipeline definitions)
.dvc/cache/
.dvc/tmp/
.dvc/*.local

# Scratch & Temporary Development Artifacts
scratch/

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
