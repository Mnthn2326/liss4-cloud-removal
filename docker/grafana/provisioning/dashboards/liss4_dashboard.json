      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum by (endpoint, status_code) (rate(api_requests_total[1m]))",
          "legendFormat": "{{endpoint}} (HTTP {{status_code}})",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP Request Rate by Endpoint & Status Code",
      "type": "timeseries"
    },
